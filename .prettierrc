{
  "useTabs": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 140,
  "plugins": ["prettier-plugin-svelte"],
  "pluginSearchDirs": ["."],
  "overrides": [
    { "files": "*.svelte", "options": { "parser": "svelte" } },
    { "files": ["*.ts", "*.js"], "options": { "objectWrap": "preserve" } }
  ]
}
