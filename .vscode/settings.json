{
  "files.exclude": {
    "**/.svelte-kit": true,
    "**/node_modules": true,
    "docs/": true
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "cSpell.language": "en,nl",
  "cSpell.words": ["Après", "clazz", "CON", "Felienne", "Nadieh", "NLZIET", "Sindarin", "TLDR", "Vaartsche"]
}
